    Ragebot.PerfRaycast = LPH_NO_VIRTUALIZE(function(Weapon, Origin, Pos, Character)-- i took this from naix once again WOW! i am the best pastaer
        local Direction   = Pos - Origin
        local Penetration = Weapon and Weapon.Properties and Weapon.Properties.Penetration or 0

        local Result = {
            Origin = Origin,
            Direction = Direction,
            Hits = {}
        }

        local IgnoreList = Money.GetRayIgnore()
        table.insert(IgnoreList, Character)

        local Data, Hitted = Money.Raycast:castThrough(
            Origin,
            Direction,
            Penetration,
            IgnoreList
        )

        local Hits = Result.Hits

        for Index = 1, #Data do
            local Hit = Data[Index]

            if Hit.Instance and Hit.Material then
                Hits[#Hits + 1] = {
                    Position = Hit.Position,
                    Instance = Hit.Instance,
                    Material = Hit.Material.Name,
                    Normal = EmptyVec3,
                    Exit = Index % 2 == 0
                }
            end
        end

        return Result, Hitted
    end)


    function Ragebot:FakeShoot(Weapon, Bullets, FireRate)
        if Weapon then
            local AnimationName = "Shoot"

            if Weapon.Properties.ShootingOptions == "Dual" then
                Weapon.ShootingHand = Weapon.ShootingHand == "Left" and "Right" or "Left"
                AnimationName = "Shoot" .. Weapon.ShootingHand
            end
            if Weapon.Viewmodel.Model.CameraShake then
				Money.Garbage.DoRecoil(Weapon.Viewmodel.Model.CameraShake)
			end
            local ShootAnimation = Weapon.Viewmodel.Animation.Animations[AnimationName]
            if ShootAnimation then
                ShootAnimation:Play()
            end
			if Weapon.Viewmodel.applyCharmImpulse then
				local LookVector = Weapon.Viewmodel.Model.WorldPivot.LookVector
				local UpVector = Weapon.Viewmodel.Model.WorldPivot.UpVector
				local v265 = LookVector * -1 + UpVector * 0.3
				Weapon.Viewmodel:applyCharmImpulse(v265)
			end
            Weapon.Viewmodel.Bobble:addScopeKick()
			if Weapon.Recoil then
				local Recoil_2 = Weapon.Recoil
				Recoil_2.Time = Recoil_2.Time + FireRate
			end
        end
    end

    Ragebot.Scan = LPH_NO_VIRTUALIZE(function(Info)

        if GetAttribute(Workspace, "GameState") == "Buy Period" then -- CLEAN UP

            -- TableClear(Ragebot["Backtrack"]["Records"])
            Ragebot["Backtrack"]:Clear(Info.Player)
            Ragebot["Backtrack"]:Clear(LocalPlayer)
            Ragebot["Forwardtrack"]:RapePos(Info.Player)
            Ragebot["Forwardtrack"]:RapePos(LocalPlayer)
            
            if Flags["RagePrepCheck"] then
                return
            end
        end


        if Info and Info.Enemy and Info.Character and Info.Invincible ~= true then
            local Weapon = Modules["InventoryController"].getCurrentEquipped()
            if not Weapon then return end

            local Properties = Weapon.Properties
            if not Properties then return end

            local FireRate = Flags["RageRapidFire"] and Flags["RapidFireTick"] or Properties.FireRate or 0.1
            if (tick() - Ragebot["Lastfired"]) < FireRate then return end

            if not Weapon.Rounds then return end
            if Weapon.Rounds <= 0 then return end

            local DefaultOrigin = Camera.CFrame.Position
            local Origins = {}
            table.insert(Origins, DefaultOrigin)

            local TargetPart = FindFirstChild(Info.Character, "Head")
            if not TargetPart then return end

            local TargetPartPosition = TargetPart.Position
            local Data, Hitted = nil, false

            if Flags["RageSelfForwardTrack"] and Flags["RageForwardTrack"] then
                local Position = Ragebot.Forwardtrack:GetPosition(LocalPlayer)
                if Position then
                    table.insert(Origins, Position)
                end
            end

            if Flags["RageOriginScan"] then -- sum slight sum slight
                local _Origins = Ragebot.HitScan:GetOrigins()
                if _Origins then
                    for Idx, Value in _Origins do
                        table.insert(Origins, Value)
                    end
                end
            end
            
            if Flags["RageSelfBackTrack"] and Flags["RageBackTrack"] then
                local Entry = Ragebot.Backtrack:GetBestRecord(LocalPlayer)
                if Entry then
                    table.insert(Origins, Entry.CFrame.Position)
                end
            end

            for Index, Origin in Origins do
                local _Data, CanIHitTwin = Ragebot.PerfRaycast(Weapon, Origin, TargetPartPosition, Info.Character)
                if CanIHitTwin then
                    Data, Hitted = _Data, CanIHitTwin
                    break
                end

                do -- mi extra check ;-;
                    if Flags["RageForwardTrack"] then
                        local Position = Ragebot.Forwardtrack:GetPosition(Info.Player)
                        if Position then
                            local _Data, CanIHitTwin = Ragebot.PerfRaycast(Weapon, Origin, Position, Info.Character)
                            if CanIHitTwin then
                                Data, Hitted = _Data, CanIHitTwin
                                break
                            end
                        end
                    end

                    if Flags["RageBackTrack"] then
                        local Entry = Ragebot.Backtrack:GetBestRecord(Info.Player)
                        if Entry then
                            local _Data, CanIHitTwin = Ragebot.PerfRaycast(Weapon, Origin, Entry.CFrame.Position, Info.Character)
                            if CanIHitTwin then
                                Data, Hitted = _Data, CanIHitTwin
                                break
                            end
                        end
                    end
                end

            end

            if not Hitted then return end

            local Hits = {}
            local OldPosition = Data.Origin

            for Index, HitData in Data.Hits do
                table.insert(Hits, {
                    Distance = (HitData.Position - OldPosition).Magnitude,
                    Instance = HitData.Instance,
                    Position = HitData.Position,
                    Normal   = HitData.Normal,
                    Material = HitData.Material,
                    Exit     = HitData.Exit
                })
                OldPosition = HitData.Position
            end

            Hits[#Hits + 1] = {
                Distance = (OldPosition - DefaultOrigin).Magnitude,
                Instance = TargetPart,
                Position = TargetPartPosition,
                Normal   = EmptyVec3,
                Material = 'Plastic',
                Exit     = false
            }

            Weapon.Rounds -= 1

            local Bullets = {
                Direction = TargetPartPosition - DefaultOrigin,
                Origin = DefaultOrigin,
                Hits = Hits
            }

            if Flags["RageForceDamage"] then
                Bullets.Hits = {
                    {
                        Instance = TargetPart,
                        Position = TargetPartPosition,
                        Normal = EmptyVec3,
                        Material = "Plastic",
                        Distance = (TargetPartPosition - DefaultOrigin).Magnitude,
                        Exit = false
                    }
                }
            end

            Remotes.Inventory.ShootWeapon.Send({
                IsSniperScoped = Weapon.IsSniperScoped,
                ShootingHand = Weapon.ShootingHand,
                Identifier = Weapon.Identifier,
                Capacity = Weapon.Capacity,
                Bullets = {Bullets},
                Rounds = Weapon.Rounds
            })

            if Flags["RageLarpShots"] then
                Ragebot:FakeShoot(Weapon, Bullets, FireRate)
            end

            Ragebot["Lastfired"] = tick()
        end
    end)

    function Ragebot:Think()
        if not Flags["RageEnabled"] then return end
        for Index, Info in EntityInfo.Players do
            Ragebot.Backtrack:Tick(Info.Player)
            Ragebot.Scan(Info) -- i had to change the netire code bruht
        end
    end
end

local Visuals = {} do
    Visuals = {
        ActiveDamageNumbers = {},
        DigitImages = {},
        Base64DigitData = {
