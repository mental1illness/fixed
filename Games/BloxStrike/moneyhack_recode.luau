        function Misc.Movement:Tick()
            local Character = LocalPlayer.Character
            if not Character then return end
            local HumanoidRootPart = Character.PrimaryPart
            if not HumanoidRootPart then return end
            -- https://github.com/mental1illness/fixed/blob/main/Unsorted/optimized%20spedhackz.luau

            if Flags["MovementSpeedHack"] and HumanoidRootPart then

                local MoveDirectionPos = EmptyVec3
                local CurrentCameraCFrame = Camera.CFrame

                local Forward = NewVector3(CurrentCameraCFrame.LookVector.X, 0, CurrentCameraCFrame.LookVector.Z).Unit
                local Right   = NewVector3(CurrentCameraCFrame.RightVector.X, 0, CurrentCameraCFrame.RightVector.Z).Unit

                local IsWDown, IsSDown, IsADown, IsDDown  = UserInputService:IsKeyDown(Enum.KeyCode.W), UserInputService:IsKeyDown(Enum.KeyCode.S), UserInputService:IsKeyDown(Enum.KeyCode.A), UserInputService:IsKeyDown(Enum.KeyCode.D)

                if IsWDown then MoveDirectionPos = MoveDirectionPos + Forward end
                if IsSDown then MoveDirectionPos = MoveDirectionPos - Forward end
                if IsADown then MoveDirectionPos = MoveDirectionPos - Right end
                if IsDDown then MoveDirectionPos = MoveDirectionPos + Right end
                
                local _OldVelocity = HumanoidRootPart.AssemblyLinearVelocity;
                if MoveDirectionPos.Magnitude > 0 then
                    HumanoidRootPart.AssemblyLinearVelocity = NewVector3(MoveDirectionPos.Unit.X * Flags["MovementSpeedValue"], _OldVelocity.Y, MoveDirectionPos.Unit.Z * Flags["MovementSpeedValue"]);
                else
                    HumanoidRootPart.AssemblyLinearVelocity = NewVector3(_OldVelocity.X * 0.75, _OldVelocity.Y, _OldVelocity.Z * 0.75);
                end
            end

            if Flags["MovementAutoJump"] and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                Modules["Controllers/CharacterController"].jump()
            end

        end
    end

