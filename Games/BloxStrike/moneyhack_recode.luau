								Lines[LineCount + 1] = RootCFrame:VectorToObjectSpace(Obj.CFrame.Position    - RootCFrame.Position)
								Lines[LineCount + 2] = RootCFrame:VectorToObjectSpace(Parent_.CFrame.Position - RootCFrame.Position)
								LineCount += 2
							end

							if Items["SkeletonWireframe"].Color3 ~= FromHex(Flags[TeamFlag .. "SkeletonColor"].HexValue) then
