local GetBloxStrikeFunction = function(Function: string)
    local _Function = nil;
    for Index, Value in Garbage do
        if typeof(Value) ~= "function" then continue end
        local SOURCE = debug.info(Value, "s")
        if string.find(SOURCE, "ReplicatedStorage") and string.find(SOURCE, Function) then
            _Function = Value
            break
        end
    end

    return _Function
end

local GetTextBounds = function(Text, FontFace, TextSize, MaxWidth)
    local Params = Instance.new("GetTextBoundsParams")
    Params.Text = tostring(Text)
    Params.Font = FontFace
    Params.Size = TextSize
    Params.Width = MaxWidth or math.huge

    local Bounds = TextService:GetTextBoundsAsync(Params)
    Params:Destroy()

    return Bounds
end


local RunOnFixedThread = function(Identity, Function, ...)
	local Old = Function; Function = function(...)
		setthreadidentity(Identity)
		return Old(...)
	end;

    task.spawn(function(...)
        local Thread = coroutine.create(Function)
        coroutine.resume(Thread, ...)
    end, ...)
end

local Modules = LPH_NO_VIRTUALIZE(function()
    local Modules = {}

    for Index, Value in getloadedmodules() do
        local Ok, Module = pcall(require, Value)
        if Ok and typeof(Module) == "table" and Module then

            if Module.getWeaponKickRotation and Module.weaponKick then
                Modules["Controllers/CameraController"] = Module
                continue
            end
        
            if Module.getCurrentEquipped then
                Modules["InventoryController"] = Module
                continue
            end

            if Module.cast and Module.castThrough then
                Modules["Raycast"] = Module
                continue
            end

            if rawget(Module, "shoot") and rawget(Module, "setupRecoil") then
                Modules["WeaponController"] = Module
                continue
            end


            if Module.jump then
                Modules["Controllers/CharacterController"] = Module
                continue
            end

            if Module.getMovementVelocity then
                Modules["Viewmodel/Bobble"] = Module
                continue
            end

            if Module.TakeStamina then
                Modules["Classes/Character"] = Module
                continue
            end

        end
    end

    return Modules
end)()


local Easing = {} do
    local Math = {
        Pow = math.pow, Sin = math.sin, Cos = math.cos, Pi = math.pi,
        Sqrt = math.sqrt, Abs = math.abs, ASin = math.asin
    }

    Easing.Linear = LPH_NO_VIRTUALIZE(function(t, b, c, d)
        return c * t / d + b
    end)

    Easing.QuartIn = LPH_NO_VIRTUALIZE(function(t, b, c, d)
        t = t / d
        return c * Math.Pow(t, 4) + b
    end)

    Easing.QuartOut = LPH_NO_VIRTUALIZE(function(t, b, c, d)
        t = t / d - 1
        return -c * (Math.Pow(t, 4) - 1) + b
    end)

    Easing.ElasticOut = LPH_NO_VIRTUALIZE(function(t, b, c, d, a, p)
        if t == 0 then return b end; t = t / d; if t == 1 then return b + c end
        p = p or d * 0.3; local s = 0
        if not a or a < Math.Abs(c) then a = c; s = p / 4 else s = p / (2 * Math.Pi) * Math.ASin(c / a) end
        return a * Math.Pow(2, -10 * t) * Math.Sin((t * d - s) * (2 * Math.Pi) / p) + c + b
    end)

    Easing.BackOut = LPH_NO_VIRTUALIZE(function(t, b, c, d, s)
        s = s or 1.70158; t = t / d - 1; return c * (t * t * ((s + 1) * t + s) + 1) + b
    end)

    Easing.BounceOut = LPH_NO_VIRTUALIZE(function(t, b, c, d)
        t = t / d
        if t < 1/2.75 then return c * (7.5625 * t * t) + b
        elseif t < 2/2.75 then t = t - 1.5/2.75; return c * (7.5625 * t * t + 0.75) + b
        elseif t < 2.5/2.75 then t = t - 2.25/2.75; return c * (7.5625 * t * t + 0.9375) + b
        else t = t - 2.625/2.75; return c * (7.5625 * t * t + 0.984375) + b
        end
    end)
end


