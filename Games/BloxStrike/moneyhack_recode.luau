    Visuals.ScreenGui = Instance.new("ScreenGui", gethui())
    Visuals.ScreenGui.IgnoreGuiInset = true
    Visuals.ScreenGui.ResetOnSpawn = false

    Visuals.DamageNumber = {} do
        function Visuals.DamageNumber.Show(Number, WorldPosition, IsEnemy, IsHeadshot)
            return LPH_JIT_MAX(function()
                if not Flags["VisualDamageNumberEnabled"] then return end
            
                local OffsettedWorldPosition = WorldPosition + NewVector3(
                    math.random(-10, 10) * 0.05,
                    math.random(0, 10) * 0.1,
                    math.random(-10, 10) * 0.05
                )
            
                local DigitString = tostring(Number)
                local BaseSize    = Flags["VisualDamageNumberBaseSize"]
                local BaseHeight  = Flags["VisualDamageNumberBaseHeight"]
                local TotalWidth  = #DigitString * BaseSize
            
                local ScreenPosition, OnScreen = Camera:WorldToViewportPoint(OffsettedWorldPosition)
                if not OnScreen then return end
            
                local StartX = ScreenPosition.X - TotalWidth / 2
                local StartY = ScreenPosition.Y - 24
            
                local TextColor = Color3.new(1, 1, 1)
                if IsHeadshot and Flags["VisualDamageNumberUseHeadshotColor"] then
                    TextColor = Flags["VisualDamageNumberHeadshotColor"].Color
                elseif IsEnemy then
                    TextColor = Flags["VisualDamageNumberEnemyColor"].Color
                else
                    TextColor = Flags["VisualDamageNumberTeamColor"].Color
                end
            
                local Images = {}
            
                for i = 1, #DigitString do
                    local Digit = tonumber(string.sub(DigitString, i, i))
                    local Image = Drawing.new("Image")
            
                    if Visuals.DigitImages[Digit] and Visuals.DigitImages[Digit].Data then
                        Image.Data = Visuals.DigitImages[Digit].Data
                    elseif Visuals.Base64DigitData[Digit + 1] and type(Visuals.Base64DigitData[Digit + 1]) == "string" then
                        Image.Data = base64.decode(Visuals.Base64DigitData[Digit + 1])
                    else
                        Image:Remove()
                        continue
                    end
            
                    Image.Size     = Vector2.new(BaseSize, BaseHeight)
                    Image.Position = Vector2.new(StartX + (i - 1) * BaseSize, StartY)
                    Image.Visible  = false
                    Image.Color    = TextColor
            
                    table.insert(Images, Image)
                end
            
                table.insert(Visuals.ActiveDamageNumbers, {
                    Images        = Images,
                    WorldPosition = OffsettedWorldPosition,
                    StartTime     = tick(),
                    Duration      = Flags["VisualDamageNumberBaseDuration"] / Flags["VisualDamageNumberSpeedMultiplier"],
                    Digits        = #DigitString,
                    BaseColor     = TextColor,
                })
            end)()
        end

        function Visuals.DamageNumber.Tick()
            return LPH_JIT_MAX(function()
                if not Flags["VisualDamageNumberEnabled"] then return end
                local CurrentTime = tick()
                local CameraPosition = Camera.CFrame.Position
            
                for Index = #Visuals.ActiveDamageNumbers, 1, -1 do
                    local DamageNumber = Visuals.ActiveDamageNumbers[Index]
                    local ElapsedTime = CurrentTime - DamageNumber.StartTime
                    local Progress = ElapsedTime / DamageNumber.Duration
            
                    if Progress > 1 then
                        for _, Image in DamageNumber.Images do
                            Image:Remove()
                        end
                        table.remove(Visuals.ActiveDamageNumbers, Index)
                        continue
                    end
            
                    local CurrentScreenPosition, OnScreen = Camera:WorldToViewportPoint(DamageNumber.WorldPosition)
                    if not OnScreen then
                        for _, Image in DamageNumber.Images do
                            Image.Visible = false
                        end
                        continue
                    end
            
                    local DistanceScaleFactor = 1
                    if Flags["VisualDamageNumberDistanceScalingEnabled"] then
                        local Distance = (CameraPosition - DamageNumber.WorldPosition).Magnitude
                        local MinDist  = Flags["VisualDamageNumberMinDistance"]
                        local MaxDist  = Flags["VisualDamageNumberMaxDistance"]
                        local MinScale = Flags["VisualDamageNumberMinDistanceScale"]
                        local MaxScale = Flags["VisualDamageNumberMaxDistanceScale"]
            
                        if Distance <= MinDist then
                            DistanceScaleFactor = MaxScale
                        elseif Distance >= MaxDist then
                            DistanceScaleFactor = MinScale
                        else
                            local LerpAlpha = (Distance - MinDist) / (MaxDist - MinDist)
                            DistanceScaleFactor = MaxScale + LerpAlpha * (MinScale - MaxScale)
                        end
                    end
            
                    local CurrentBaseSize   = Flags["VisualDamageNumberBaseSize"]   * DistanceScaleFactor
                    local CurrentBaseHeight = Flags["VisualDamageNumberBaseHeight"]  * DistanceScaleFactor
            
                    local BaseFade     = Easing.QuartIn(Progress, 0, 1, 1)
                    local Transparency = 1 * (1 - BaseFade)
                    local RiseAmount   = BaseFade
            
                    local CurrentTotalWidth = DamageNumber.Digits * CurrentBaseSize
                    local CurrentBaseX = CurrentScreenPosition.X - CurrentTotalWidth / 2
                    local CurrentBaseY = CurrentScreenPosition.Y - 24
            
                    for DigitIndex, Image in DamageNumber.Images do
                        local DigitDuration = 1 + DigitIndex * 0.25
                        local DigitProgress = ElapsedTime / (DamageNumber.Duration * DigitDuration / DamageNumber.Digits)
            
                        if DigitProgress > 0 then
                            Image.Visible = true
            
                            local ElasticEffect = Easing.ElasticOut(ElapsedTime, 0, 1, DigitDuration) - BaseFade
                            local AnimationScale = Flags["VisualDamageNumberMinScale"] + ElasticEffect * Flags["VisualDamageNumberMaxScale"]
                            local YOffset = -(Flags["VisualDamageNumberRiseHeight"]) * RiseAmount
            
                            local Alpha = 1
                            if Progress > Flags["VisualDamageNumberFadeStartPoint"] then
                                Alpha = Transparency
                            end
            
                            local Spacing = CurrentBaseSize * AnimationScale
                            local CenterOffset = (DamageNumber.Digits * Spacing - CurrentTotalWidth) / 2
            
                            Image.Position = Vector2.new(
                                CurrentBaseX + (DigitIndex - 1) * Spacing - CenterOffset,
                                CurrentBaseY + YOffset
                            )
                            Image.Size = Vector2.new(CurrentBaseSize * AnimationScale, CurrentBaseHeight * AnimationScale)
                            Image.Transparency = Alpha
                            Image.Color = DamageNumber.BaseColor
                        else
                            Image.Visible = false
                        end
                    end
                end
            end)()
        end

    end

    
    do -- kill effect
        Visuals.Items["KillEffect"] = Instance.new("ImageLabel", Visuals.ScreenGui)
        Visuals.Items["KillEffect"].Size = UDim2.new(1, 0, 1, 0)
        Visuals.Items["KillEffect"].Image = Library.Assets["Vignette.png"]
        Visuals.Items["KillEffect"].BackgroundTransparency = 1
