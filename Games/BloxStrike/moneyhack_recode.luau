            if not Flags["VisualKillEffect"] then return end
            if Visuals.KillEffect.KillEffectTween then
                Visuals.KillEffect.KillEffectTween:Cancel()
                Visuals.KillEffect.KillEffectTween = nil
            end
            
            if not Visuals.Items["KillEffectBlur"] then
