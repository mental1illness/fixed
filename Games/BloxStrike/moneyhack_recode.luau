end)()

local Ragebot = { ["Forwardtrack"] = {}, ["Backtrack"] = {}, ["HitScan"] = {} } do
    Ragebot["Lastfired"] = 0
    Ragebot["CurrentWeapon"] = nil
    Ragebot["WeaponProperties"] = nil


    -- The start of something new..
    Ragebot.Forwardtrack = { Pos = {} } do
        local RayParams = NewRaycastParams() -- only for fwt
        RayParams.FilterType = Enum.RaycastFilterType.Exclude

        function Ragebot.Forwardtrack:GetPosition(Player)

            local Character = Player.Character
            if not Character then return nil end
            local HumanoidRootPart = Character.PrimaryPart
            if not HumanoidRootPart then return nil end

            local Velocity = HumanoidRootPart.AssemblyLinearVelocity
            local Position = HumanoidRootPart.Position
            local pt = Flags["RageForwardTrackMS"] / 1000

            local PredictedPosition
            if Flags["RageForwardTrackBiDirection"] then
                local Fsociety = NewVector3(Velocity.X, 0, Velocity.Z)
                local Forward = Position + Fsociety * pt
                local Backward = Position - Fsociety * pt
                PredictedPosition = Fsociety:Dot(Forward - Position) >= Fsociety:Dot(Backward - Position) and Forward or Backward
            else
                PredictedPosition = Position + Velocity * pt
            end

            if Flags["RageForwardTrackCollisions"] then
                local IgnoreList = Money.GetRayIgnore()
                table.insert(IgnoreList, Character)
                RayParams.FilterDescendantsInstances = IgnoreList
                local Result = Raycast(workspace, Position, PredictedPosition - Position, RayParams)
                if Result then
                    PredictedPosition = Result.Position
                end
            end

            local sp = self.Pos[Player]
            if not sp then
                self.Pos[Player] = PredictedPosition
                return PredictedPosition
            end

            local NyanIllCacheYouMeow = NewVector3(
                sp.X * 0.65 + PredictedPosition.X * 0.35,
                sp.Y * 0.65 + PredictedPosition.Y * 0.35,
                sp.Z * 0.65 + PredictedPosition.Z * 0.35
            )
            self.Pos[Player] = NyanIllCacheYouMeow
            return NyanIllCacheYouMeow
        end

        function Ragebot.Forwardtrack:RapePos(Player)
            self.Pos[Player] = nil
        end
    end

    Ragebot.Backtrack = { Records = {} } do

        function Ragebot.Backtrack:Tick(Player)
            if not Flags["RageBackTrack"] then return end

            local Character = Player.Character
            if not Character then return end
            local HumanoidRootPart = Character.PrimaryPart
            if not HumanoidRootPart then return end

            if not self.Records[Player] then
                self.Records[Player] = {}
            end

            local Record = self.Records[Player]
            local Now = tick()
            local Window = Flags["RageBackTrackMS"] / 1000

            table.insert(Record, 1, {
                CFrame = HumanoidRootPart.CFrame,
                Time = Now
            })

            for i = #Record, 1, -1 do
                if Now - Record[i].Time > Window then
                    table.remove(Record, i)
                end
            end
        end

        function Ragebot.Backtrack:GetRecords(Player)
            return self.Records[Player]
        end

        function Ragebot.Backtrack:GetBestRecord(Player)
            local Record = self.Records[Player]
            if not Record or #Record == 0 then return nil end

            local Now = tick()
            local Window = Flags["RageBackTrackMS"] / 1000

            for i = #Record, 1, -1 do
                if Now - Record[i].Time <= Window then
                    return Record[i]
                end
            end

            return nil
        end

        function Ragebot.Backtrack:Clear(Player)
            self.Records[Player] = nil
        end
    end

    Ragebot.HitScan = {} do
        local RayParams = NewRaycastParams()
        RayParams.FilterType = Enum.RaycastFilterType.Exclude

        function Ragebot.HitScan:ScanDirection(Dir)
            local Origin = Camera.CFrame.Position
            local MaxScan = Flags["RageOriginMaxScan"]
            local ScaledDir = Camera.CFrame:VectorToWorldSpace(Dir).Unit * MaxScan

            if Flags["RageOriginScanCollisionCheck"] and Character then
                RayParams.FilterDescendantsInstances = Money.GetRayIgnore()
                local RayResult = Raycast(workspace, Origin, ScaledDir, RayParams)
                if RayResult then
                    return RayResult.Position
                end
            end

            return Origin + ScaledDir
        end

        function Ragebot.HitScan:GetOrigins()
