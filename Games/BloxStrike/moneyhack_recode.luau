            Visuals.Items["KillEffectBlur"].Size = 0
        end
    end
    
    --[[
            local KillEffect = VCamera:Toggle{Name = "kill effect", flag = "VisualKillEffect", Tooltip = "An effect will be shown when a player has been killed by you."}
            KillEffect:Colorpicker{Name = "kill effect color", Default = Color3.fromRGB(255, 255, 255), flag = "VisualKillEffectColor"}
