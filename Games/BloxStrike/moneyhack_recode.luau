                            Parent = Items["Backpack"].Instance,
                            Image = Icon,
                            BackgroundTransparency = 1,
                            Size = UDim2.new(0, 100, 0, 100),
                            BorderSizePixel = 0
                        })
                    end

                    Indicator:Center()

                    return setmetatable(Indicator, Library)
                end

