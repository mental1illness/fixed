                            Items["KeybindWindow"]:FadeDescendants(false, function()
                                Items["KeybindWindow"].Instance.Parent = Library.UnusedHolder.Instance
                                Debounce = false
                            end)

                            if Library.OpenFrames[Keybind] then
                                Library.OpenFrames[Keybind] = nil
