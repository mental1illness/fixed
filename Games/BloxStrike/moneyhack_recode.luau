							Items["SkeletonWireframe"]:Clear()
						end
						if Items["WireframeChams"] then
							Items["WireframeChams"]:Clear()
						end
						continue 
					end

					if not Cache["Childrens"][Model] then
						local Children = Model:GetChildren()
