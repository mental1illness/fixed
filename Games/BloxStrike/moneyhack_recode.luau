do
    local CheckIfMethodIsValid = function(Self, Method)
        return type(Self[Method]) == "function"
    end

    local Namecall; Namecall = hookmetamethod(game, "__namecall", newcclosure(LPH_NO_VIRTUALIZE(function(self, ...) -- i just cant optimize this
        local Method = getnamecallmethod()

        if self == game and Method == "WaitForChild" then
            local Args = {...}
            if typeof(Args[1]) == "table" then
                return false, "invalid argument #1 to 'WaitForChild' (string expected, got table)"
            end
        end

        if not CheckIfMethodIsValid(self, Method) then
            return false, Method .. ' is not a valid member of DataModel "Ugc"'
        end

        if Method == "FireServer" then
            local Args = {...}

            local Name = self.Name
            if Name == "ShootWeapon" then
                task.spawn(function()
                    local Data = Args[1]
                    if Data and Data.Bullets then
                        for Index, Value in Data.Bullets do
                            local CurBullet = Data.Bullets[Index]
                            if CurBullet then
                                local Hits = CurBullet.Hits
                                if not Hits or #Hits == 0 then continue end
                                for _, HitData in Hits do
                                    local _Instance = HitData.Instance
                                    if not _Instance then continue end
                                    if not _Instance.Parent:IsA("Model") then continue end
                                    
                                    local Plr = GetPlayerFromCharacter(Players, _Instance.Parent)
                                    if Plr and Plr ~= LocalPlayer then
                                        RunOnFixedThread(Identity, Misc.HitPlayer, Plr, _Instance)
                                        break
                                    end
                                end
                            end
                        end
                    end
                end)
            end
        end

        return Namecall(self, ...)
    end)))
end

