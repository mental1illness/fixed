                Visuals.Items["KillEffectBlur"].Name = "\0"
                Visuals.Items["KillEffectBlur"].Size = 0
            end
            Visuals.Items["KillEffect"].ImageColor3 = Flags["VisualKillEffectColor"].Color
            Visuals.Items["KillEffect"].ImageTransparency = 0
            Visuals.Items["KillEffectBlur"].Size = 20
            local Tween = TweenService:Create(Visuals.Items["KillEffect"], TweenInfo.new(Flags["VisualKillEffectDuration"], Enum.EasingStyle.Cubic), { ImageTransparency = 1 })
            Tween:Play()
            
            local Tween2 = TweenService:Create(Visuals.Items["KillEffectBlur"], TweenInfo.new(Flags["VisualKillEffectDuration"], Enum.EasingStyle.Cubic), { Size = 0 })
            Tween2:Play()
            
            Visuals.KillEffect.KillEffectTween = Tween
