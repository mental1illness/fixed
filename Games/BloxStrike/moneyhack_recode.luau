					local MinX, MinY, MaxX, MaxY = ESP:GetBoundingBox(Children, (Flags["BoundingBoxType"] or "Dynamic"))

					if not MinX then
						Items["Holder"].Visible = false
						continue
					end
					
					do -- resizing part heh
						Cache["SkeletonTick"] += Delta
						
						Items["Holder"].Visible = true
						Items["Holder"].Size     = UDim2.fromOffset(MaxX - MinX, MaxY - MinY)
						Items["Holder"].Position = UDim2.fromOffset(MinX, MinY)


						local MaxHealth, Health = ESP:GetHealth(Model)
						local Distance = ESP:GetDistance(Model)
						if Health <= 0 then
							ESP:ChangeTransparency(Entity, Lerp( 	
								Entity["Cache"]["FadeNumber"] or 0,
								1,
								math.min(1, Delta * 4)
							))
							Entity["Cache"]["FadeNumber"] = Lerp(Entity["Cache"]["FadeNumber"] or 0, 1, math.min(1, Delta * 4))
							Items["Holder"].Visible = Entity["Cache"]["FadeNumber"] < 0.99
						else
							Entity["Cache"]["FadeNumber"] = 0
							ESP:ChangeTransparency(Entity, 0)
						end

						do
							local ESPMaxDist = Flags["ESPMaxDistance"]
							local FadeOnDist = Flags["FadeOnDistance"]
							local FadeStart  = ESPMaxDist * 0.6
							local FadeRange  = ESPMaxDist - FadeStart

							if Distance > ESPMaxDist then
								Items["Holder"].Visible = false
								continue
							end

							if Entity["Cache"]["FadeNumber"] > 0 then
							elseif FadeOnDist and Distance > FadeStart then
								local FadeAlpha = math.floor(((Distance - FadeStart) / FadeRange) * 200 + 0.5) / 200
								ESP:ChangeTransparency(Entity, FadeAlpha)
							else
								ESP:ChangeTransparency(Entity, 0)
							end
						end	

						if Cache["SkeletonTick"] > Cache["SkeletonUpdateRate"] then
