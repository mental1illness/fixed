				if Value and typeof(Value) == "Instance" then
					Value:Destroy()
				end
			end

			for Index, Value in Entity["Events"] do
				if Value then
					Value:Disconnect()
				end
			end

			ESP["Entities"][Model] = nil
		end

		function ESP:RemovePlayer(Player: Player)
			local _Player = nil

			for Index, Value in ESP["Players"] do
				if Value == Player then
					_Player = Index
					break
				end
			end

			if not _Player then return end

			if _Player["EntityTable"] then
				if _Player["EntityTable"] then ESP:RemoveEntity(_Player["EntityTable"].Model) end
			end

			for Index, Value in _Player["Connections"] do
				if Value then
					Value:Disconnect()
				end
			end

			ESP["Players"][_Player] = nil
		end

		function ESP:AddPlayer(Player: Player)
			local _Player = {
				["Connections"] = {},
				["EntityTable"] = nil,
			}
			ESP["Players"][_Player] = Player

			_Player["Connections"][#_Player["Connections"] + 1] = Player.CharacterAdded:Connect(function(Character)
				_Player["EntityTable"] = ESP:AddEntity(Character)
			end)

			_Player["Connections"][#_Player["Connections"] + 1] = Player.CharacterRemoving:Connect(function(Character)
				if _Player["EntityTable"] then
					ESP:RemoveEntity(Character)
					_Player["EntityTable"] = nil
				end
			end)

			if Player.Character then
				_Player["EntityTable"] = ESP:AddEntity(Player.Character)
			end

			return _Player
		end

		function ESP:GetBoundingBox(Children: {}, Type: string)
            if Type == "Dynamic" then
                local MinX, MinY = math.huge, math.huge
                local MaxX, MaxY = -math.huge, -math.huge

                for _, Part in Children do
                    if not Part:IsA("BasePart") or Part.Transparency > 0.1 then continue end

                    local HalfSize = Part.Size / 2
                    local PartCFrame = Part.CFrame

                    local Corners = {
                        NewVector3( HalfSize.X,  HalfSize.Y,  HalfSize.Z),
                        NewVector3(-HalfSize.X,  HalfSize.Y,  HalfSize.Z),
                        NewVector3( HalfSize.X, -HalfSize.Y,  HalfSize.Z),
                        NewVector3( HalfSize.X,  HalfSize.Y, -HalfSize.Z),
                        NewVector3(-HalfSize.X, -HalfSize.Y,  HalfSize.Z),
                        NewVector3( HalfSize.X, -HalfSize.Y, -HalfSize.Z),
                        NewVector3(-HalfSize.X,  HalfSize.Y, -HalfSize.Z),
                        NewVector3(-HalfSize.X, -HalfSize.Y, -HalfSize.Z),
                    }

                    for _, Corner in Corners do
                        local WorldPoint = PartCFrame * Corner
                        local ScreenPoint, IsOnScreen = Camera:WorldToViewportPoint(WorldPoint)

                        if not IsOnScreen or ScreenPoint.Z <= 0 then continue end

                        if ScreenPoint.X < MinX then MinX = ScreenPoint.X end
                        if ScreenPoint.Y < MinY then MinY = ScreenPoint.Y end
                        if ScreenPoint.X > MaxX then MaxX = ScreenPoint.X end
                        if ScreenPoint.Y > MaxY then MaxY = ScreenPoint.Y end
                    end
                end

                if MinX == math.huge then return nil end

                return MinX, MinY, MaxX, MaxY

			elseif Type == "Static" then
				local HumanoidRootPart = nil

				for _, Part in Children do
					if Part.Name == "HumanoidRootPart" then
						HumanoidRootPart = Part
						break
					end
				end

				if not HumanoidRootPart then return end

				local ScreenPosition, IsOnScreen = Camera:WorldToViewportPoint(HumanoidRootPart.Position)

				if not IsOnScreen or ScreenPosition.Z <= 0 then return end

				local ViewportY = Camera.ViewportSize.Y
				local Scale = (ViewportY * 1.5) / (ScreenPosition.Z * 2 * math.tan((Camera.FieldOfView * (math.pi / 180)) / 2))

				local BoxWidth = 3.0833 * Scale
				local BoxHeight = 3.6364 * Scale

				local MinX = math.floor(ScreenPosition.X - (BoxWidth / 2))
				local MinY = math.floor(ScreenPosition.Y - (BoxHeight / 2.5))
				local MaxX = math.floor(MinX + BoxWidth)
				local MaxY = math.floor(MinY + BoxHeight)

				return MinX, MinY, MaxX, MaxY
			end
		end

		function ESP:Update(Delta, CurrentTick)
			for Index, Value in ESP["Entities"] do
				local Model, Entity = Index, Value -- WOW! FOR NO REASON.. EPIC!!
				local Items = Entity and Entity["Items"]

				local RootPart = Model.PrimaryPart

				if Model and Items then
