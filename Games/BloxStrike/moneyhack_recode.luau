do -- thanks naix for this this looks a little ai though
    LPH_NO_VIRTUALIZE(function()
        local PenetrationParams = NewRaycastParams()
        PenetrationParams.FilterType = Enum.RaycastFilterType.Include
        PenetrationParams.CollisionGroup = "Bullet"
        
        local Params = NewRaycastParams()
        Params.CollisionGroup = "Bullet"

        local function ProcessPenetration(Origin, Direction, Instance, Hits, VariantDistances, MaterialDistances, TotalDistance, MaxPenetration)
            PenetrationParams.FilterDescendantsInstances = { Instance }

            local EndPosition = Origin + Direction
            local Result = Raycast(workspace, EndPosition, Origin - EndPosition, PenetrationParams)

            if not Result then
                return EmptyVec3, TotalDistance, false
            end

            local HitPosition = Result.Position
            local Distance = (Origin - HitPosition).Magnitude
            local NewTotalDistance = TotalDistance + Distance

            local Variant = Result.Instance.MaterialVariant
            if Variant ~= "" then
                local VariantLimit = Money.Constants.MaterialVariant[Variant]
                if VariantLimit then
                    local CurrentDistance = (VariantDistances[Variant] or 0) + Distance
                    VariantDistances[Variant] = CurrentDistance

                    if CurrentDistance > VariantLimit + MaxPenetration then
                        return HitPosition, NewTotalDistance, true
                    end

                    table.insert(Hits, Result)
                    return HitPosition, NewTotalDistance, false
                end
            end

            local Material = Result.Material
            local CurrentDistance = (MaterialDistances[Material] or 0) + Distance
            MaterialDistances[Material] = CurrentDistance

            if CurrentDistance > (Money.Constants.MaterialDepth[Material] or 20) + MaxPenetration then
                return HitPosition, NewTotalDistance, true
            end

            table.insert(Hits, Result)
            return HitPosition, NewTotalDistance, false
        end

        local function SimulateBulletPenetration(Origin, Direction, MaxPenetration, RayParams)
            local Hits = {}
            local VariantDistances = {}
            local MaterialDistances = {}
            local TotalDistance = 0

            for _ = 1, 100 do
                local Result = Raycast(workspace, Origin, Direction, RayParams)
                if not Result then break end

                RayParams:AddToFilter(Result.Instance)
                table.insert(Hits, Result)

                local NewOrigin, NewTotalDistance, ShouldStop = ProcessPenetration(
                    Result.Position, Direction, Result.Instance,
                    Hits, VariantDistances, MaterialDistances,
                    TotalDistance, MaxPenetration
                )

                if NewOrigin ~= EmptyVec3 then
                    Origin = NewOrigin
                end
                TotalDistance = NewTotalDistance

                if ShouldStop then
                    return Hits, false
                end
            end

            return Hits, true
        end

        function Money.Raycast:castThrough(Origin, Direction, MaxPenetration, IgnoreList)
            if IgnoreList then
                Params.FilterDescendantsInstances = IgnoreList
            end
            return SimulateBulletPenetration(Origin, Direction, MaxPenetration, Params)
        end
    end)()
end

do
    Money.Funcs.GetDamageFromName = LPH_NO_VIRTUALIZE(function(Gun, Name)
        local RealName = Name
        local Lower = string.lower(Name)
        if Lower == "humanoidrootpart" then
            RealName = "Torso"
        elseif string.find(Lower, "arm", 1, true) then
            RealName = "Arms"
        elseif string.find(Lower, "torso", 1, true) then
            RealName = "Torso"
        elseif string.find(Lower, "leg", 1, true) then
            RealName = "Legs"
        end

        if Gun then
            local Settings = Money.Constants.WeaponSettings[Gun]
            if Settings and Settings["DamagePerPart"] ~= nil then
                return (Settings["DamagePerPart"][RealName] or 100)
            end
        end

        return 0
    end)
end

