local EntityInfo = { Players = {} }; do
    function EntityInfo:GetTeam(Entry: {})
        local OurTeam = GetAttribute(LocalPlayer, "Team") -- LocalPlayer.Team
        local TheirTeam = GetAttribute(Entry.Player, "Team")-- Entry.Player.Team

        return TheirTeam, OurTeam ~= TheirTeam -- Team, IsEnemy
    end

    function EntityInfo:UpdateEntry(PlayerEntry)
        local Player = PlayerEntry.Player
        local Character = Player.Character

        if Character then
            local Humanoid = FindFirstChildOfClass(Character, "Humanoid")

            PlayerEntry.Character = Character
            PlayerEntry.Invincible = GetAttribute(Character, "Invincible")
            PlayerEntry.RootPart = (Character.PrimaryPart or FindFirstChild(Character, "HumanoidRootPart"))

            if Humanoid then
                PlayerEntry.Health = (Humanoid.Health or 0)
                PlayerEntry.MaxHealth = (Humanoid.MaxHealth or 0)
                PlayerEntry.Alive = Humanoid.Health > 0
            else
                PlayerEntry.Health = 0
                PlayerEntry.MaxHealth = 0
                PlayerEntry.Alive = false
            end
        else
            PlayerEntry.Character = nil
            PlayerEntry.RootPart = nil
            PlayerEntry.Health = 0
            PlayerEntry.MaxHealth = 0
            PlayerEntry.Alive = false
        end

        local Team, IsEnemy = self:GetTeam(PlayerEntry)
        if Team then
            PlayerEntry.Enemy = IsEnemy
            PlayerEntry.Team = Team
        end
    end

    function EntityInfo:Update()
        for Player, PlayerEntry in self.Players do
            self:UpdateEntry(PlayerEntry)
        end
    end

    function EntityInfo:Cache(Player: Player)
        if Player and Player ~= LocalPlayer then
            local PlayerEntry = {
                Character = nil,
                RootPart = nil,
                Alive = false,
                Enemy = false,
                Team = nil,
                Player = Player,
                Health = 100,
                MaxHealth = 100,
                Invincible = false,
            }
            self.Players[Player] = PlayerEntry
            self:UpdateEntry(PlayerEntry)
        end
    end

    function EntityInfo:CleanEntry(Player)
        self.Players[Player] = nil
    end
end

